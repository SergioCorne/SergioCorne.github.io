---
import "@fontsource-variable/inter";
import "@fontsource/ibm-plex-mono/latin-400.css";
import "../styles/global.css";
import Architecture from "./Architecture.astro";
import {
  profile,
  experience,
  stack,
  certification,
  project,
  personalProjects,
  type Locale,
} from "../data/profile";
import { copy } from "../data/copy";
interface Props {
  lang: Locale;
}
const { lang } = Astro.props;
const t = copy[lang];
const sections = ["about", "stack", "experience", "projects", "contact"];
const canonical = `${profile.site}${lang === "es" ? "/es/" : "/"}`;
const schema = {
  "@context": "https://schema.org",
  "@type": "ProfilePage",
  inLanguage: lang,
  mainEntity: {
    "@type": "Person",
    name: profile.name,
    jobTitle: profile.role,
    url: profile.site,
    sameAs: [profile.linkedin, profile.github],
    knowsAbout: ["Kubernetes", "Terraform", "Cloud infrastructure", "GitOps"],
    alumniOf: {
      "@type": "CollegeOrUniversity",
      name: "Universidad de Castilla-La Mancha",
    },
  },
};
---

<!doctype html>
<html lang={lang}>
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="theme-color" content="#0c0d14" />
    <title>{t.title}</title>
    <meta name="description" content={t.description} />
    <link rel="canonical" href={canonical} />
    <link rel="alternate" hreflang="en" href={`${profile.site}/`} />
    <link rel="alternate" hreflang="es" href={`${profile.site}/es/`} />
    <link rel="alternate" hreflang="x-default" href={`${profile.site}/`} />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <meta property="og:type" content="website" />
    <meta property="og:title" content={t.title} />
    <meta property="og:description" content={t.description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:locale" content={lang === "es" ? "es_ES" : "en_GB"} />
    <meta
      property="og:locale:alternate"
      content={lang === "es" ? "en_GB" : "es_ES"}
    />
    <meta property="og:image" content={`${profile.site}/social-card.png`} />
    <meta
      property="og:image:alt"
      content="Sergio Cornejo · Platform Engineer · Cloud, Kubernetes & Automation"
    />
    <meta name="twitter:card" content="summary_large_image" />
    <script type="application/ld+json" set:html={JSON.stringify(schema)} />
  </head>
  <body>
    <a class="skip-link" href="#main">
      {t.skip}
    </a>
    <header class="site-header">
      <div class="header-inner">
        <a href="#top" class="brand">
          <span class="brand-mark" aria-hidden="true">
            s<span>c</span>
            <i></i>
          </span>
          <span>
            Sergio Cornejo<span class="brand-sub">Platform Engineer</span>
          </span>
        </a>
        <button
          class="menu-toggle mono"
          aria-expanded="false"
          aria-controls="navigation"
        >
          {t.menu}
          <span aria-hidden="true">＋</span>
        </button>
        <nav
          id="navigation"
          aria-label={
            lang === "es" ? "Navegación principal" : "Main navigation"
          }
        >
          {sections.map((id, i) => (
            <a href={`#${id}`} data-nav={id}>
              {t.nav[i]}
            </a>
          ))}
        </nav>
        <a class="header-contact" href="#contact">
          {t.contact}
        </a>
        <a
          class="language mono"
          href={lang === "en" ? "/es/" : "/"}
          lang={lang === "en" ? "es" : "en"}
          aria-label={t.language}
          data-language
        >
          {lang === "en" ? "ES" : "EN"}
          <span aria-hidden="true">↗</span>
        </a>
      </div>
    </header>
    <main id="main">
      <section class="hero wrap" id="top" aria-labelledby="hero-title">
        <h1 class="hero-identity" id="hero-title">
          Sergio
          <span>
            Cornejo<span class="name-dot">.</span>
          </span>
        </h1>
        <div class="hero-copy">
          <p class="hero-role">
            Platform Engineer
            <br class="role-break" />
            <span>Cloud & DevOps</span>
          </p>
          <p class="hero-intro">{t.intro}</p>
          <ul
            class="hero-skills"
            aria-label={lang === "es" ? "Especialidades" : "Specialties"}
          >
            {["Kubernetes", "Terraform", "GitOps", "Cloud", "CI/CD"].map(
              (skill) => (
                <li>{skill}</li>
              ),
            )}
          </ul>
          <div class="hero-actions">
            <a class="button primary" href="#projects">
              {lang === "es" ? "Ver mis proyectos" : "View my projects"}
              <span aria-hidden="true">↗</span>
            </a>
            <a class="button secondary" href={profile.linkedin}>
              LinkedIn<span aria-hidden="true">↗</span>
            </a>
            <a class="button outlined" href="#contact">
              {t.contact}
              <span aria-hidden="true">↗</span>
            </a>
          </div>
          <p class="location mono">
            <span class="status-dot"></span>
            {t.location}
            <span class="location-divider" aria-hidden="true">
              /
            </span>
            Platform Engineering
          </p>
        </div>
        <div class="hero-bottom mono">
          <a href="#about">
            {t.scroll}
            <span aria-hidden="true">↓</span>
          </a>
          <a href={profile.github}>
            GitHub / SergioCorne<span aria-hidden="true">↗</span>
          </a>
        </div>
      </section>
      <section
        class="section wrap about"
        id="about"
        aria-labelledby="about-title"
      >
        <div>
          <p class="eyebrow mono">{t.aboutLabel}</p>
          <h2 id="about-title">
            {t.aboutTitle.split("\n").map((line) => (
              <span class="line">{line}</span>
            ))}
          </h2>
        </div>
        <div class="about-content">
          {t.aboutText.map((p) => (
            <p>{p}</p>
          ))}
          <div class="principles">
            {t.principles.map((p, i) => (
              <div>
                <span class="mono">0{i + 1}</span>
                <div>
                  <h3>{p[0]}</h3>
                  <p>{p[1]}</p>
                </div>
              </div>
            ))}
          </div>
        </div>
      </section>
      <section
        class="section stack-section"
        id="stack"
        aria-labelledby="stack-title"
      >
        <div class="wrap">
          <div class="section-heading">
            <div>
              <p class="eyebrow mono">{t.stackLabel}</p>
              <h2 id="stack-title">{t.stackTitle}</h2>
            </div>
            <p>{t.stackIntro}</p>
          </div>
          <div class="platform-overview">
            <div class="platform-copy">
              <p class="eyebrow mono">
                {lang === "es"
                  ? "DEL CÓDIGO A LA PLATAFORMA"
                  : "FROM CODE TO PLATFORM"}
              </p>
              <h3>
                {lang === "es"
                  ? "Cada capa tiene un propósito."
                  : "Every layer has a purpose."}
              </h3>
              <p>{t.heroNote}</p>
              <p>
                {lang === "es"
                  ? "Explora el diagrama para ver cómo se conectan infraestructura declarativa, entrega continua, Kubernetes y observabilidad."
                  : "Explore the diagram to see how declarative infrastructure, continuous delivery, Kubernetes and observability connect."}
              </p>
            </div>
            <Architecture lang={lang} />
          </div>
          <div class="stack-grid">
            {stack.map((group) => (
              <article class="stack-group">
                <div class="stack-heading">
                  <span class="mono stack-number">{group.mark}</span>
                  <h3>{group.name[lang]}</h3>
                </div>
                <p>{group.context[lang]}</p>
                <ul class="tool-list">
                  {group.tools.map((tool) => (
                    <li>
                      <span class="tool-dot" aria-hidden="true"></span>
                      {tool}
                    </li>
                  ))}
                </ul>
              </article>
            ))}
          </div>
        </div>
      </section>
      <section
        class="section wrap"
        id="experience"
        aria-labelledby="experience-title"
      >
        <div class="section-heading">
          <div>
            <p class="eyebrow mono">{t.expLabel}</p>
            <h2 id="experience-title">{t.expTitle}</h2>
          </div>
          <p>{t.expIntro}</p>
        </div>
        <div class="timeline">
          {experience.map((job, i) => (
            <article class="job">
              <div class="job-date mono">
                <span
                  class:list={["timeline-dot", { current: i === 0 }]}
                ></span>
                <span>{job.period[lang]}</span>
                {i === 0 && <span class="current-label">{t.current}</span>}
              </div>
              <div class="job-content">
                <div class="job-heading">
                  <h3>{job.company}</h3>
                  <span class="mono">0{experience.length - i}</span>
                </div>
                <p class="job-role">{job.role[lang]}</p>
                <p>{job.intro[lang]}</p>
                <details open={i === 0}>
                  <summary>
                    {t.responsibilities}
                    <span aria-hidden="true">＋</span>
                  </summary>
                  <ul>
                    {job.bullets[lang].map((b) => (
                      <li>{b}</li>
                    ))}
                  </ul>
                </details>
                <ul class="tags">
                  {job.tags.map((tag) => (
                    <li>
                      {tag === "Technical documentation" && lang === "es"
                        ? "Documentación técnica"
                        : tag}
                    </li>
                  ))}
                </ul>
              </div>
            </article>
          ))}
        </div>
      </section>
      <section
        class="section projects-section"
        id="projects"
        aria-labelledby="projects-title"
      >
        <div class="wrap">
          <div class="section-heading">
            <div>
              <p class="eyebrow mono">{t.projectLabel}</p>
              <h2 id="projects-title">{t.projectTitle}</h2>
            </div>
            <p>{t.projectIntro}</p>
          </div>
          {personalProjects.map((item) => (
            <article class="case-study personal-project" aria-label={item.name}>
              <div class="case-intro">
                <span class="project-status">
                  <span class="status-dot" aria-hidden="true"></span>
                  {item.status[lang]}
                </span>
                <h3>{item.name}</h3>
                <div class="project-team">
                  {lang === "es" ? "Un proyecto con" : "A project with"}{" "}
                  <a href={item.teamUrl}>{item.team}</a>
                </div>
                <p>{item.description[lang]}</p>
                <div class="project-links">
                  <a class="text-link" href={item.url}>
                    {lang === "es"
                      ? "Ver proyecto en desarrollo"
                      : "View development preview"}
                    <span aria-hidden="true">↗</span>
                  </a>
                  <a class="text-link" href={item.teamUrl}>
                    {lang === "es" ? "Conocer WoAS" : "Meet WoAS"}
                    <span aria-hidden="true">↗</span>
                  </a>
                </div>
              </div>
              <dl class="project-facts">
                {item.facts.map((fact) => (
                  <div>
                    <dt>{fact.title[lang]}</dt>
                    <dd>{fact.text[lang]}</dd>
                  </div>
                ))}
              </dl>
            </article>
          ))}
          <article class="case-study">
            <div class="case-intro">
              <p class="eyebrow mono">{t.caseLabel}</p>
              <h3>
                {t.caseTitle.split("\n").map((line) => (
                  <span class="line">{line}</span>
                ))}
              </h3>
              <p>{t.caseIntro}</p>
              <ul class="tags">
                {project.tags.map((tag) => (
                  <li>{tag}</li>
                ))}
              </ul>
              <a class="text-link" href={project.url}>
                {t.readCase}
                <span aria-hidden="true">↗</span>
              </a>
              <p class="case-note mono">{t.caseNote}</p>
            </div>
            <div class="case-process">
              {t.caseSteps.map((step) => (
                <div>
                  <span class="mono">{step[0]}</span>
                  <div>
                    <h4>{step[1]}</h4>
                    <p>{step[2]}</p>
                  </div>
                </div>
              ))}
            </div>
          </article>
        </div>
      </section>
      <section
        class="section wrap education"
        id="education"
        aria-labelledby="education-title"
      >
        <div>
          <p class="eyebrow mono">{t.eduLabel}</p>
          <h2 id="education-title">{t.eduTitle}</h2>
        </div>
        <div class="education-items">
          <article>
            <span class="mono">{t.degreeDate}</span>
            <h3>{t.degree}</h3>
            <p class="institution">{t.university}</p>
            <p>{t.degreeText}</p>
          </article>
          <article class="certification">
            <div class="cert-mark" aria-hidden="true">
              <svg viewBox="0 0 40 40">
                <path d="M0 0h18v18H0zM22 0h18v18H22zM0 22h18v18H0zM22 22h18v18H22z" />
              </svg>
            </div>
            <div>
              <span class="mono">
                {t.obtained} / {certification.date[lang]}
              </span>
              <h3>{certification.name}</h3>
              <p>Microsoft</p>
              <a class="text-link" href={certification.url}>
                {t.verify}
                <span aria-hidden="true">↗</span>
              </a>
            </div>
          </article>
        </div>
      </section>
      <section
        class="contact-section"
        id="contact"
        aria-labelledby="contact-title"
      >
        <div class="wrap">
          <p class="eyebrow mono">{t.contactLabel}</p>
          <div class="contact-grid">
            <h2 id="contact-title">
              {t.contactTitle.split("\n").map((line) => (
                <span class="line">{line}</span>
              ))}
            </h2>
            <div>
              <p>{t.contactText}</p>
              <div class="contact-actions">
                <a class="button primary" href={profile.linkedin}>
                  {t.linkedin}
                  <span aria-hidden="true">↗</span>
                </a>
                {profile.cv && (
                  <a
                    class="button outlined contact-cv"
                    href={profile.cv}
                    download="CV_Sergio_Cornejo.pdf"
                  >
                    {t.downloadCv}
                    <span aria-hidden="true">↓</span>
                  </a>
                )}
                <a class="button outlined contact-cv" href={profile.github}>
                  {t.github}
                  <span aria-hidden="true">↗</span>
                </a>
              </div>
              {profile.email && (
                <a
                  class="contact-email text-link"
                  href={`mailto:${profile.email}`}
                >
                  {profile.email}
                  <span aria-hidden="true">↗</span>
                </a>
              )}
            </div>
          </div>
          <div class="contact-sign mono">
            <span>SERGIO CORNEJO</span>
            <span>PLATFORM ENGINEER</span>
            <span aria-hidden="true">{}</span>
          </div>
        </div>
      </section>
    </main>
    <footer class="site-footer wrap">
      <span>© {new Date().getFullYear()} Sergio Cornejo</span>
      <span>{t.footer}</span>
      <a href="#top">
        {t.top}
        <span aria-hidden="true">↑</span>
      </a>
    </footer>
    <script>
      const menu = document.querySelector<HTMLButtonElement>(".menu-toggle");
      const nav = document.querySelector("nav");
      menu?.addEventListener("click", () => {
        const expanded = menu.getAttribute("aria-expanded") === "true";
        menu.setAttribute("aria-expanded", String(!expanded));
        nav?.classList.toggle("open", !expanded);
      });
      function closeMenu() {
        menu?.setAttribute("aria-expanded", "false");
        nav?.classList.remove("open");
      }
      nav
        ?.querySelectorAll("a")
        .forEach((link) => link.addEventListener("click", closeMenu));
      document.addEventListener("keydown", (event) => {
        if (event.key === "Escape") {
          closeMenu();
          if (
            document.activeElement instanceof HTMLElement &&
            document.activeElement.closest("nav")
          )
            menu?.focus();
        }
      });
      const observer = new IntersectionObserver(
        (entries) => {
          entries.forEach((entry) => {
            if (entry.isIntersecting) {
              document.querySelectorAll("[data-nav]").forEach((link) => {
                if (link.getAttribute("data-nav") === entry.target.id)
                  link.setAttribute("aria-current", "location");
                else link.removeAttribute("aria-current");
              });
            }
          });
        },
        { rootMargin: "-15% 0px -60% 0px" },
      );
      document
        .querySelectorAll("main section[id]")
        .forEach((section) => observer.observe(section));
      document
        .querySelector<HTMLAnchorElement>("[data-language]")
        ?.addEventListener("click", (event) => {
          const link = event.currentTarget as HTMLAnchorElement;
          link.href += window.location.hash;
          try {
            localStorage.setItem(
              "portfolio-language",
              document.documentElement.lang === "en" ? "es" : "en",
            );
          } catch {
            /* Storage may be disabled. URLs retain the selected language. */
          }
        });
    </script>
  </body>
</html>
